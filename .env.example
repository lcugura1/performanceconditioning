# Google recenzije (scripts/fetch-google-reviews.mjs), iste varijable i na Cloudflare Pagesu
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Drive sync (docs/postavljanje.md, Faza 1–2), iste varijable kao GitHub i Worker secrets
DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# R2 (Faza 3b): bez njih `npm run sync` piše u public/media
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pc-media
# Javna adresa bucketa (r2.dev dok domena nije na Cloudflareu, zatim https://img.performanceconditioning.hr)
MEDIA_BASE=

# Deploy na Cloudflare Workers (Faza 3c)
CLOUDFLARE_API_TOKEN=
